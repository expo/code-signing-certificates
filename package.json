{
  "name": "@expo/code-signing-certificates",
  "version": "0.0.6",
  "description": "A library for working with expo-updates code signing certificates",
  "keywords": [
    "code signing"
  ],
  "homepage": "https://github.com/expo/code-signing-certificates/tree/main#readme",
  "bugs": {
    "url": "https://github.com/expo/code-signing-certificates/issues"
  },
  "license": "MIT",
  "author": "Expo <support@expo.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/code-signing-certificates.git"
  },
  "files": [
    "build"
  ],
  "main": "build/main.js",
  "types": "build/main.d.ts",
  "scripts": {
    "tsc": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "clean": "rm -rf build coverage coverage-integration",
    "lint": "oxlint --type-aware . --max-warnings=0 && yarn format-check",
    "lint-fix": "oxlint --type-aware --fix . && yarn format",
    "format": "oxfmt --write .",
    "format-check": "oxfmt --check .",
    "test": "jest --rootDir . --config jest.config.js",
    "generate-example-certificates": "tsx ./scripts/generateExampleCertificates.ts",
    "generate-example-self-signed": "tsx ./scripts/generateExampleSelfSignedCertificate.ts",
    "generate-certificates-for-tests": "tsx ./scripts/generateCertificatesForTests.ts",
    "oidgen": "tsx ./scripts/oidgen/oidgen.ts",
    "sign-manifest-for-testing": "tsx ./scripts/signManifestForTesting.ts",
    "sanity-check-signature": "tsx ./scripts/sanityCheckSignature.ts",
    "generate-expo-go-intermediate-certificate": "tsx ./scripts/generateExpoGoIntermediateCertificate.ts"
  },
  "dependencies": {
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.28",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/node-forge": "^1.3.14",
    "jest": "^30",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-config-universe": "^0.2.0",
    "oxlint-tsgolint": "7.0.2003",
    "ts-jest": "^29.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "uuid": "^14"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
