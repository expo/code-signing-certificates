{
  "extends": ["@tsconfig/bases/strictest", "@tsconfig/bases/node22"],
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "skipLibCheck": false,
    "allowJs": true,
    "rootDir": ".",
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["scripts", "src"],
  "exclude": ["src/__tests__"]
}
